FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET=change-me

# SQLite 默认落在仓库根目录的 data/app.db
DATABASE_URL=
AUTO_CREATE_TABLES=1
ENABLE_SYNC_ANALYZE=1

# auto: 有 Key 走真实接口，没 Key 自动用测试夹具
LLM_MODE=auto
# 阿里云百炼华北2（北京）OpenAI 兼容接口
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_SEGMENT=qwen3.8-max
LLM_MODEL_ANALYSIS=qwen3.8-max
LLM_MODEL_VISION=qwen3.8-max
LLM_MODEL_POLYSEMY=qwen3.8-max
LLM_CONCURRENCY=3
LLM_MAX_CONTINUATIONS=3

TARGET_LEVEL=zhongkao
EXAM_TAG_SOURCE=table
MAX_DOC_CHARS=20000
SENTENCE_BATCH_SIZE=5

# 美元/百万 token，按实际渠道改
LLM_PRICE_IN_PER_1M=0.15
LLM_PRICE_OUT_PER_1M=0.60
USD_TO_CNY=7.2
